# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# test coverage (generado por `npm run test:coverage`)
/coverage

# estado efímero del CLI de Supabase (generado por `supabase start`).
# .temp incluye start-secrets/**/docker.env con las llaves de la instancia local: nunca se versiona.
supabase/.temp/
supabase/.branches/

# env
.env
.env.local
.env*.local

# misc
.DS_Store

# llaves y credenciales. Ninguno de estos archivos existe en el arbol ni en el historial: esto es
# tapar un hueco de la red, no limpiar una fuga (CN-024).
*.pem
*.key
*.p12
credentials.json
service-account*.json
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts
