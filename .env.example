# Supabase (crea un proyecto en https://supabase.com y aplica las migraciones en supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... # solo servidor, nunca exponer al navegador

# URL pública de la app (usada para enlaces en notificaciones, webhooks y eventos de calendario)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar OAuth (Google Cloud Console > Credenciales > ID de cliente OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback

# Captcha del alta pública (/registro) Y del inicio de sesión (/login). OPCIONAL: sin estas dos
# variables las dos páginas funcionan igual, sin widget. Se encienden juntas o no se enciende nada.
#
# Valores de NEXT_PUBLIC_CAPTCHA_PROVIDER: turnstile | hcaptcha (son los dos que Supabase verifica
# de forma nativa).
#
# OJO, LAS DOS MITADES VAN JUNTAS: poner esto aquí sólo dibuja el widget y manda el token. Quien
# VERIFICA el token es el proyecto de Supabase (Authentication → Settings → Bot and Abuse
# Protection, con la CLAVE SECRETA del mismo proveedor). EL ORDEN IMPORTA: primero despliega con
# estas variables y comprueba que el login funciona; sólo después actívalo en el panel. Al revés,
# Supabase exige el token en el login y deja fuera a todo el mundo. Detalle en CLAUDE.md.
NEXT_PUBLIC_CAPTCHA_PROVIDER=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# Link compartible del reporte de métricas (/reportes/[clientId]/[anio]/[mes]) y su PDF
# (/api/reportes/pdf). OPCIONAL: sin esta variable, /metricas sigue funcionando igual, solo sin
# los botones "Copiar link para compartir" y "Descargar PDF" -- misma filosofía que el captcha, la
# app no depende de una clave que nadie ha puesto todavía.
#
# Cualquier cadena larga y al azar sirve (ej. `openssl rand -hex 32`). Es la clave con la que se
# firma cada link (HMAC-SHA256, ver lib/reportes.ts) -- nunca la pegues en un commit ni la
# compartas: quien la tenga puede armar el link de cualquier marca de esta agencia. Cambiarla
# invalida TODOS los links ya compartidos a la vez (es la única forma de "revocarlos": no vencen
# por sí solos).
REPORT_LINK_SECRET=
