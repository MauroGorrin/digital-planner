# Supabase (crea un proyecto en https://supabase.com y aplica las migraciones en supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... # solo servidor, nunca exponer al navegador

# URL pública de la app (usada para enlaces en notificaciones, webhooks y eventos de calendario)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar OAuth (Google Cloud Console > Credenciales > ID de cliente OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback

# Captcha del alta pública (/registro). OPCIONAL: sin estas dos variables el registro funciona
# igual, sin widget. Se encienden juntas o no se enciende nada.
#
# Valores de NEXT_PUBLIC_CAPTCHA_PROVIDER: turnstile | hcaptcha (son los dos que Supabase verifica
# de forma nativa en /auth/v1/signup).
#
# OJO, LAS DOS MITADES VAN JUNTAS: poner esto aquí sólo dibuja el widget y manda el token. Quien
# VERIFICA el token es el proyecto de Supabase, así que además hay que activar el mismo proveedor
# con su CLAVE SECRETA en el panel (Authentication → Settings → Bot and Abuse Protection). Con una
# mitad sola, o no hay protección o el alta rebota.
NEXT_PUBLIC_CAPTCHA_PROVIDER=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
